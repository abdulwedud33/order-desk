{
  "name": "order-desk",
  "version": "0.1.0",
  "private": true,
  "description": "Order management web app for restaurants, cafes, delivery businesses and repair shops.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/postbuild.mjs && node scripts/check-bundle.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "tsx --test tests/**/*.test.ts",
    "test:db": "supabase test db",
    "test:node": "node --import ./scripts/ts-resolve.mjs --test tests/**/*.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "dexie": "^4.0.8",
    "dexie-react-hooks": "^1.1.7",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "fake-indexeddb": "^6.2.8",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module"
}
